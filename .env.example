# Variables de entorno de la función api/contact.js.
# En producción se configuran en Vercel: Project > Settings > Environment Variables.
# Para pruebas locales con `vercel dev`, copia este archivo a .env.local y completa los valores.
# Nunca subas claves reales al repositorio.

# Clave de API de Resend (resend.com > API Keys).
RESEND_API_KEY=

# Correo que recibe las consultas del formulario.
CONTACT_TO=

# Remitente (opcional). Si se omite, se usa "DTA Next <onboarding@resend.dev>",
# que solo permite enviar al correo dueño de la cuenta de Resend.
# Con un dominio verificado en Resend: "DTA Next <contacto@tudominio.cl>".
CONTACT_FROM=

# Webhook de Discord para avisar cada consulta (opcional).
# Discord: canal > Editar canal > Integraciones > Webhooks > Copiar URL del webhook.
DISCORD_WEBHOOK_URL=
